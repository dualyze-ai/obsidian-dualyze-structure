{
  "name": "obsidian-dualyze-structure",
  "version": "1.0.0",
  "description": "Turn long notes into structured knowledge",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "builtin-modules": "^5.2.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^obsidian$": "<rootDir>/src/__mocks__/obsidian.ts"
    },
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__mocks__/**",
      "!src/main.ts",
      "!src/settings.ts",
      "!src/ConfirmModal.ts",
      "!src/fileWriter.ts"
    ]
  }
}
